#   keytool -genkey -v -keystore ~/corterm-release.keystore -alias corterm \
#     -keyalg RSA -keysize 2048 -validity 10000
storePassword=********
keyPassword=********
keyAlias=corterm
storeFile=/absolute/path/to/corterm-release.keystore
